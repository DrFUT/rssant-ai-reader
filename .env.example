# ===========================================================================
# 复制为 .env 后按需修改:  cp .env.example .env
# 只有 AI_API_KEY 是"想要 AI 能力"才必须填的, 其他都有可用默认值。
# ===========================================================================

# ---------------------------------------------------------------------------
# 基础配置
# ---------------------------------------------------------------------------
# 生产环境请务必随机生成一个新值(例如: python -c "import secrets;print(secrets.token_urlsafe(48))")
RSSANT_SECRET_KEY=please-change-this-secret-key
# 对外访问地址
RSSANT_ROOT_URL=http://localhost:6789
# 宿主机映射端口
RSSANT_WEB_PORT=6789
# 订阅源检查间隔(分钟)
RSSANT_CHECK_FEED_MINUTES=30

# 首次启动自动创建的管理员账号(登录后即可直接使用)
RSSANT_SUPERUSER_USERNAME=admin
RSSANT_SUPERUSER_PASSWORD=admin123456
RSSANT_SUPERUSER_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# AI 配置  —— 支持 DeepSeek / OpenAI 以及任何 OpenAI 兼容接口
# ---------------------------------------------------------------------------
# 留空也能跑: 系统会降级为"规则分类 + RSS 原文摘要", 只是没有 LLM 增强
AI_ENABLE=1
AI_API_KEY=
# DeepSeek: https://api.deepseek.com
# OpenAI:   https://api.openai.com
# 月之暗面: https://api.moonshot.cn
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 单次 LLM 请求超时(秒)
AI_TIMEOUT=30
# 每轮巡查最多处理多少篇文章(防止后台任务堆积)
AI_BATCH_SIZE=20
# 每日简报的生成时间(24 小时制, 容器时区为 Asia/Shanghai)
AI_DIGEST_HOUR=8
AI_DIGEST_MINUTE=10

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
RSSANT_PG_DB=rssant
RSSANT_PG_USER=rssant
RSSANT_PG_PASSWORD=rssant

# ---------------------------------------------------------------------------
# 可选: GitHub 登录 / SMTP 邮件(不需要可留空)
# ---------------------------------------------------------------------------
RSSANT_GITHUB_CLIENT_ID=
RSSANT_GITHUB_SECRET=
RSSANT_SMTP_ENABLE=false
RSSANT_SMTP_HOST=
RSSANT_SMTP_PORT=
RSSANT_SMTP_USERNAME=
RSSANT_SMTP_PASSWORD=
